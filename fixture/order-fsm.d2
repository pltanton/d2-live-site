title: |md
  # Order checkout

  Solid: the engine moves on by itself. Dashed: waits for an outside event.
| {near: top-center}

direction: down

classes: {
  active: {
    shape: rectangle
    style: {fill: "#EEF5FF"; stroke: "#6B9AE6"; stroke-width: 2; border-radius: 8}
  }
  pause: {
    shape: rectangle
    style: {fill: "#FFF8E8"; stroke: "#D6A21B"; stroke-width: 2; stroke-dash: 4; border-radius: 8}
  }
  done_ok: {
    shape: rectangle
    style: {fill: "#1E7A40"; stroke: "#1E7A40"; font-color: "#FFFFFF"; border-radius: 16}
  }
  done_bad: {
    shape: rectangle
    style: {fill: "#B23B3B"; stroke: "#B23B3B"; font-color: "#FFFFFF"; border-radius: 16}
  }
  evt: {style: {stroke: "#2B6CB0"; stroke-width: 2; stroke-dash: 4}}
  sync: {style: {stroke: "#334155"; stroke-width: 2}}
}

start: "" {shape: circle; width: 18; height: 18; style: {fill: "#334155"; stroke: "#334155"}}

CART_LOCKED: {class: active}
PAYMENT_PENDING: "PAYMENT_PENDING\nwaits for the card network" {class: pause}
PAYMENT_CAPTURED: {class: active}
SHIPPED: {class: active}
COMPLETED: {class: done_ok}
CANCELLED: {class: done_bad}

start -> CART_LOCKED: "checkout" {class: sync}
CART_LOCKED -> PAYMENT_PENDING: "ask the payment provider" {class: sync}

# The provider answers asynchronously; a decline ends the order with nothing to undo.
PAYMENT_PENDING -> PAYMENT_CAPTURED: "payment: CAPTURED" {class: evt}
PAYMENT_PENDING -> CANCELLED: "payment: DECLINED" {class: evt}

PAYMENT_CAPTURED -> SHIPPED: "hand to the carrier" {class: sync}
SHIPPED -> COMPLETED: "carrier: DELIVERED" {class: evt}
